# Copy to deploy/.env for local Compose acceptance. Use a secret manager in production.
APP_ENV=development
HTTP_PORT=8088

POSTGRES_DB=ant_browser
POSTGRES_USER=ant_migration
POSTGRES_PASSWORD=replace-with-a-long-random-password
CONTROL_PLANE_DB_PASSWORD=replace-with-a-different-long-random-password
WORKER_DB_PASSWORD=replace-with-another-long-random-password
# A fresh Compose volume provisions ant_control_plane and ant_worker as
# LOGIN,NOBYPASSRLS roles before the migration job grants their privileges.
MIGRATION_DATABASE_URL=postgres://ant_migration:replace-with-a-long-random-password@postgres:5432/ant_browser?sslmode=disable
CONTROL_PLANE_DATABASE_URL=postgres://ant_control_plane:replace-with-a-different-long-random-password@postgres:5432/ant_browser?sslmode=disable
WORKER_DATABASE_URL=postgres://ant_worker:replace-with-another-long-random-password@postgres:5432/ant_browser?sslmode=disable

REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379/0
NATS_USER=ant-browser
NATS_PASSWORD=replace-with-a-long-random-password
NATS_URL=nats://ant-browser:replace-with-a-long-random-password@nats:4222

# Optional email delivery. WebSocket and in-app notifications work without it.
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

MINIO_ROOT_USER=ant-browser-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ant-browser-artifacts
S3_REGION=us-east-1

JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
ENCRYPTION_KEY_REF=cloud-kms://ant-browser/profile-artifacts
# Generate exactly 32 random bytes and base64-encode them. Never commit the
# production value; inject it through your deployment secret manager.
SECRET_MASTER_KEY=replace-with-base64-encoded-32-byte-key
SECRET_KEY_VERSION=v1

# Required only when enabling deploy/compose/proxy-health.yml.
# Mount reviewed xray, sing-box, and mihomo Linux binaries from this directory.
PROXY_CONNECTOR_DIR=/opt/ant-browser/connectors
PROXY_PROBE_TARGET=https://api.ipify.org?format=json
