# Copy to deploy/.env for local Compose acceptance and replace every
# "replace-with-..." value. In production inject these through a secret
# manager instead of a file; never commit deploy/.env.
#
# Generating secrets (openssl shown; any CSPRNG works):
#   openssl rand -hex 32      passwords and JWT_SIGNING_KEY (64 hex chars).
#                             Hex stays URL-safe; base64 output contains
#                             + / = which must be percent-encoded in *_URL.
#   openssl rand -base64 32   SECRET_MASTER_KEY only (must decode to 32 bytes).

# production keeps every startup safety check on: durable PostgreSQL/Redis/
# NATS/object storage required, development JWT and master keys rejected, an
# explicit CORS origin list required, plain-text SMTP forbidden, and the worker
# must use its own ant_worker URL. APP_ENV=development silently disables all
# of these; use it only for a throwaway stack on your own machine.
APP_ENV=production
HTTP_PORT=8088

# Private bridge network for the stack. Pinned so the control plane can trust
# forwarded client-IP headers from the bundled Nginx only. Change both values
# together if the subnet overlaps an existing Docker network, VPN, or route.
# If another proxy/load balancer sits in front of Nginx, keep this set to the
# Nginx range and configure Nginx real_ip for the outer proxy instead.
CLOUD_NETWORK_SUBNET=172.28.0.0/16
TRUSTED_PROXY_CIDRS=172.28.0.0/16

POSTGRES_DB=ant_browser
POSTGRES_USER=ant_migration
# Three distinct principals, each: openssl rand -hex 32. Repeat each password
# inside the matching *_DATABASE_URL below.
POSTGRES_PASSWORD=replace-with-a-long-random-password
CONTROL_PLANE_DB_PASSWORD=replace-with-a-different-long-random-password
WORKER_DB_PASSWORD=replace-with-another-long-random-password
# deploy/postgres/init-runtime-roles.sh creates ant_control_plane and
# ant_worker as LOGIN,NOBYPASSRLS roles ONLY when the postgres-data volume is
# first initialised. On a reused volume or an external database, migration 018
# creates them as NOLOGIN; run the ALTER ROLE ... WITH LOGIN PASSWORD steps in
# docs/cloud-deployment.md before starting the services.
MIGRATION_DATABASE_URL=postgres://ant_migration:replace-with-a-long-random-password@postgres:5432/ant_browser?sslmode=disable
CONTROL_PLANE_DATABASE_URL=postgres://ant_control_plane:replace-with-a-different-long-random-password@postgres:5432/ant_browser?sslmode=disable
WORKER_DATABASE_URL=postgres://ant_worker:replace-with-another-long-random-password@postgres:5432/ant_browser?sslmode=disable

# openssl rand -hex 32; REDIS_URL must embed the same password.
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379/0
NATS_USER=ant-browser
# openssl rand -hex 32; NATS_URL must embed the same user and password.
NATS_PASSWORD=replace-with-a-long-random-password
NATS_URL=nats://ant-browser:replace-with-a-long-random-password@nats:4222

# Optional email delivery. WebSocket and in-app notifications work without it.
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

# Object storage credentials go to the control plane only; the worker never
# receives them. Password: openssl rand -hex 32 (MinIO needs at least 8 chars).
MINIO_ROOT_USER=ant-browser-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ant-browser-artifacts
S3_REGION=us-east-1

# HMAC signing key, at least 32 characters: openssl rand -hex 32
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
# Envelope key label (not a secret) bound into every stored secret.
ENCRYPTION_KEY_REF=cloud-kms://ant-browser/profile-artifacts
# openssl rand -base64 32 -> 44 characters that decode to exactly 32 bytes.
# The control plane and the proxy-health worker reject anything else, and
# reject the published development key outside development. The key, the
# label above, and SECRET_KEY_VERSION must match on both services; changing
# any of them makes existing stored secrets undecryptable.
SECRET_MASTER_KEY=replace-with-base64-encoded-32-byte-key
SECRET_KEY_VERSION=v1
# Exact origins only; never use *. Keep the Wails origin and add the hosted
# operator UI origin when one is deployed.
ALLOWED_ORIGINS=http://wails.localhost,http://localhost:8088,https://app.example.com

# Required only when enabling deploy/compose/proxy-health.yml.
# Mount reviewed xray, sing-box, and mihomo Linux binaries from this directory.
PROXY_CONNECTOR_DIR=/opt/ant-browser/connectors
PROXY_PROBE_TARGET=https://api.ipify.org?format=json
